# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-key-here

# LLM Model (optional, default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Firestore Configuration
# Enable conversation storage (optional, default: false)
USE_FIRESTORE=true

# Port (optional, default: 8000)
PORT=8000

# CORS allowed origins (optional, default: *)
# Comma-separated list, e.g., "https://example.com,https://app.example.com"
ALLOWED_ORIGINS=*

# Max file upload size in MB (optional, default: 10)
MAX_FILE_SIZE_MB=10

